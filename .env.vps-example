# ============================================================
# VPS Deploy Environment Variables
# For self-hosted Supabase on Coolify
# ============================================================

# --- Supabase Connection (Local Self-Hosted) ---
# URL of the self-hosted Kong API gateway
VITE_SUPABASE_URL=http://localhost:8000
# Alternative names used by Netlify functions
SUPABASE_URL=http://localhost:8000

# API Keys - use opaque keys from your self-hosted Supabase .env
# SUPABASE_PUBLISHABLE_KEY (anon access - safe for frontend)
VITE_SUPABASE_ANON_KEY=your_publishable_key_here

# SUPABASE_SECRET_KEY (service_role access - server-side only!)
# WARNING: Never prefix with VITE_ — that would expose it in the frontend bundle
SUPABASE_SERVICE_ROLE_KEY=your_secret_key_here

# Direct DB connection (for migration scripts)
SUPABASE_DB_URL=postgresql://supabase_admin:***@localhost:5432/postgres
SUPABASE_DB_PASSWORD=your_postgres_password_here

# --- Server Config ---
CORS_ORIGIN=*
API_PORT=3001

# Secret for authenticating webhook calls
x_momentum_secret=your_secret_here

# --- External Services ---
# OneSignal Push Notifications
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# n8n Webhooks (AI features)
N8N_DESCRIPTION_WEBHOOK_URL=
N8N_PROJECT_WEBHOOK_URL=

# Sentry
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
